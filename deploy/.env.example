# Open Instinct environment. Copy to deploy/.env (docker compose) or export in your shell.
# Every variable is read by the server, gateway or CLI process only; libraries take options.
# config.json under the data dir wins over env after the first boot; env seeds it.

# ----- Model -----------------------------------------------------------------------------
# provider/model from the Pi catalog. Default anthropic/claude-fable-5-1.
# "openai-compatible/<model-id>" uses OPENAI_BASE_URL and OPENAI_API_KEY (vLLM, Ollama, LiteLLM).
INSTINCT_MODEL=anthropic/claude-fable-5-1
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1

# ----- Who the owner is (seeded into config.json on first boot) --------------------------
INSTINCT_OWNER_NAME=Maria
INSTINCT_OWNER_PHONE=+15551234567
INSTINCT_OWNER_EMAIL=maria@example.com
# 1 when the phone is not known yet (a signup that asked for a name only): the first person who texts
# the agent 1:1 on iMessage or SMS a message containing INSTINCT_OWNER_CLAIM_CODE becomes the owner,
# exactly once. Leave unset when the phone is set. Texting first is not enough: without a code (at
# least 8 letters/digits; use 16+ random ones) nobody can claim, and boot logs a warning. Show the code
# only to the person who signed up (e.g. prefilled in their sms: link). Case, spaces and dashes are
# ignored. A wrong code leaves the sender a stranger; each number gets 10 tries. After a claim the
# code and the flag are removed from config.json and the code is stripped before the model sees it.
# INSTINCT_CLAIM_OWNER_ON_FIRST_CONTACT=0
# INSTINCT_OWNER_CLAIM_CODE=
# Optional ISO time after which the code stops working, e.g. 2026-11-01T00:00:00Z.
# INSTINCT_OWNER_CLAIM_EXPIRES_AT=
INSTINCT_OWNER_TIMEZONE=America/New_York
# Name the agent introduces itself with.
INSTINCT_AGENT_NAME=Instinct
# Optional standing instructions, written to <data>/AGENTS.md. A changed value replaces the file on
# the next boot unless the owner edited it. INSTINCT_PERSONA seeds PERSONA.md on first boot only.
# INSTINCT_INSTRUCTIONS=

# ----- State -----------------------------------------------------------------------------
# Default: /data if it exists (Maritime), else ./.instinct.
INSTINCT_DATA_DIR=/data
# SKILL.md playbooks. Default: <repo>/skills (the image copies it to /app/skills).
INSTINCT_SKILLS_DIR=/app/skills
# Milliseconds /chat waits for the model before acknowledging and finishing in the background. Default 20000.
# INSTINCT_REPLY_BUDGET_MS=20000
# 1: when the owner's own 1:1 iMessage or SMS is still being worked on after that budget, text one
# "on it" into the thread first instead of silence until the answer lands. Never for a text queued
# behind another, a group, or anyone but the owner. Off by default.
# INSTINCT_ACK_SLOW_REPLIES=0

# ----- Who may talk to the agent over HTTP -----------------------------------------------
# /chat, /status and /schedules are the owner's surface: a plain message there runs with every
# owner tool. With a token set, each call must send `Authorization: Bearer <token>` (or the
# X-Instinct-Token header) or it gets 401. Leave empty only when the port is unreachable to
# others: the server binds 127.0.0.1 unless PORT or a MARITIME_* variable is set, and inside
# a Maritime VM only Maritime's own authenticated API reaches /chat. `instinct dev` and
# `instinct chat` pass the token for you. Generate one with: openssl rand -hex 24
INSTINCT_CHAT_TOKEN=
# Bind address override. Default: 127.0.0.1, or 0.0.0.0 when PORT or MARITIME_* is set.
# INSTINCT_BIND=127.0.0.1
# Public URL of this agent, when it has one (used for the Link payments callback).
# INSTINCT_PUBLIC_URL=https://maria-instinct.example.com

# ----- Inkbox: phone number, iMessage, email, agent identity ------------------------------
# Identity-scoped key for this agent (minted with the admin key: POST /api/v1/api-keys { scoped_identity_id }).
INKBOX_API_KEY=
INKBOX_AGENT_HANDLE=maria-instinct
INKBOX_IDENTITY_ID=
# Webhook signing key for POST /webhooks/inkbox. The server also reads <data>/secrets/webhook.json.
INKBOX_SIGNING_KEY=
# Org-wide admin key. Needed to provision identities, mint keys, subscribe webhooks, invitations.
# Required by the gateway; optional for a single self-hosted agent.
INKBOX_ADMIN_API_KEY=
# Self-hosted only: open an Inkbox tunnel from the server and subscribe webhooks to it. The
# tunnel reaches a loopback listener that serves /health and /webhooks/inkbox only; /chat is
# never public through it.
INSTINCT_TUNNEL=0

# ----- Maritime key (one key, used by two consumers) -------------------------------------
# Control-plane key (Bearer mk_...). Needed by:
#   - a single agent for the hosted desktop fallback: scope `computers` (or `manage` / `*`)
#   - the gateway, to create agents and relay chat: scopes `deploy` and `secrets` (or `manage` / `*`)
# Define it once. A computers-only key is refused by the agents API, so a deployment that
# runs both the gateway and hosted computers needs a key with `manage` or `*`.
MARITIME_API_KEY=

# ----- Computer --------------------------------------------------------------------------
# auto (desktopd in the Maritime VM if present, else hosted Computers MCP if MARITIME_API_KEY, else none),
# desktopd, maritime, none.
INSTINCT_COMPUTER=auto
# Hosted Maritime Computers endpoint (uses MARITIME_API_KEY above).
MARITIME_COMPUTERS_MCP_URL=https://mcp.maritime.sh

# ----- Apps through Composio (Gmail, Google Calendar, Contacts, ...) ----------------------
# Setting the key turns apps on.
COMPOSIO_API_KEY=
# Comma-separated toolkit slugs. Default gmail,googlecalendar,googlecontacts,linear,custom_oxygen.
# Set to `all` to allow every Composio app: the owner then connects Notion, Slack, GitHub
# and so on by name from a text. See docs/COMPOSIO.md for what each mode lets the model do.
COMPOSIO_TOOLKITS=gmail,googlecalendar,googlecontacts,linear,custom_oxygen
# Optional: direct (one tool per app action, tiers apply per tool) or router (Composio's
# meta tools, owner only). Unset picks router for OpenAI-style models such as the Maritime
# LLM proxy, which reject more than 128 tools, and direct otherwise.
# COMPOSIO_MODE=
# POSTIZ_MCP_URL: MCP wrapper around a self-hosted Postiz public API. Turns on the
# custom_postiz toolkit; each person saves their own Postiz API key on the connect page.
# POSTIZ_MCP_URL=

# ----- Payments: Stripe Link agent wallet (optional) --------------------------------------
# All three must be set for payment tools to appear. The client id and secret are not in the
# Stripe dashboard: apply through Stripe's Link OAuth App Registration form (linked from
# https://docs.stripe.com/agentic-commerce/link-cli), reviewed every 3 to 5 days. The
# publishable key is in the dashboard under Developers > API keys. See docs/PAYMENTS.md.
LINK_CLIENT_ID=
LINK_CLIENT_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Where Link sends the owner after they approve. Default INSTINCT_PUBLIC_URL + /oauth/link/callback,
# else http://127.0.0.1:$PORT/oauth/link/callback. Behind the gateway, point it at the gateway's
# callback URL; the gateway relays it to the agent as a link.oauth_callback envelope.
# LINK_REDIRECT_URI=

# ----- Images ----------------------------------------------------------------------------
# Optional. image_generate posts to {IMAGE_BASE_URL}/images/generations (OpenAI-compatible). Without a
# key the tool tells the owner image generation is not set up. Falls back to OPENAI_API_KEY and
# OPENAI_BASE_URL, so an OpenAI-compatible proxy that forwards /images/generations needs nothing extra.
# IMAGE_API_KEY=
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_MODEL=gpt-image-1

# ----- Web search ------------------------------------------------------------------------
# Optional. Without it web_search falls back to the DuckDuckGo HTML endpoint.
BRAVE_SEARCH_API_KEY=
# Optional. Adds sourced live-web answers and public page research through Context.dev.
CONTEXT_DEV_API_KEY=

# ----- Web apps --------------------------------------------------------------------------
# Optional. Lets the agent put the sites and apps it builds online through Ample (docs/AMPLE.md).
# AMPLE_SIGNUP=1: no key; each agent signs up for its own account on its first deploy (use this on the gateway).
AMPLE_SIGNUP=
# Or one shared account: a credential from `ample auth signup` or `ample auth agent create`. AMPLE_TOKEN also works.
AMPLE_CLIENT_ID=
AMPLE_CLIENT_SECRET=

# ----- Injected by Maritime inside a hosted agent (do not set by hand) -------------------
# PORT=18789            (never 8080 inside a Maritime VM: that port is reserved there)
# MARITIME_AGENT_ID=
# MARITIME_BACKEND_URL=
# MARITIME_INTERNAL_TOKEN=
# MARITIME_DESKTOP=1    (the VM has a desktop; the server waits for desktopd to come up)

# ----- Gateway (multi-user relay) --------------------------------------------------------
# Uses MARITIME_API_KEY from the Maritime section above.
# Override the control plane for staging. Default https://api.maritime.sh.
# MARITIME_API_URL=https://api.maritime.sh
# Public URL of the gateway: webhook target and the connect page.
GATEWAY_PUBLIC_URL=https://instinct.example.com
GATEWAY_DATA_DIR=/data
# Optional shared secret that signup requests must present.
GATEWAY_SIGNUP_SECRET=
# Image the gateway deploys for each new user.
INSTINCT_AGENT_IMAGE=ghcr.io/mariagorskikh/open-instinct-agent:latest
# How long an idle agent VM stays awake before Maritime puts it to sleep (default 900).
# INSTINCT_IDLE_TTL_SECONDS=900
# Self-hosted Inkbox only.
# INKBOX_BASE_URL=https://inkbox.ai

# Aliases the gateway also accepts (older names): GATEWAY_OPEN_SIGNUP (same as GATEWAY_ALLOW_OPEN_SIGNUP),
# INSTINCT_COMPOSIO_TOOLKITS (same as COMPOSIO_TOOLKITS).
