# Open Instinct postiz-mcp image: the stateless MCP wrapper around the
# self-hosted Postiz public API. One per deployment; each request carries the
# caller's own Postiz key (BYOK) in Authorization.
FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc tsconfig.base.json ./
# pnpm validates the frozen lockfile against every workspace importer, so each
# package.json must be present even though only postiz-mcp is installed.
COPY patches ./patches
COPY packages/core/package.json packages/core/
COPY packages/inkbox/package.json packages/inkbox/
COPY packages/computer/package.json packages/computer/
COPY packages/context/package.json packages/context/
COPY packages/apps/package.json packages/apps/
COPY packages/network/package.json packages/network/
COPY packages/payments/package.json packages/payments/
COPY packages/ample/package.json packages/ample/
COPY packages/atomicmail/package.json packages/atomicmail/
COPY packages/server/package.json packages/server/
COPY packages/gateway/package.json packages/gateway/
COPY packages/postiz-mcp/package.json packages/postiz-mcp/
COPY packages/cli/package.json packages/cli/
RUN pnpm install --frozen-lockfile --filter @open-instinct/postiz-mcp

FROM deps AS build
COPY packages/postiz-mcp ./packages/postiz-mcp
RUN pnpm --filter @open-instinct/postiz-mcp run build

FROM base AS runtime
ENV NODE_ENV=production \
    PORT=3000
COPY --from=build /app /app
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s CMD curl -fsS "http://127.0.0.1:${PORT}/health" || exit 1
CMD ["node", "packages/postiz-mcp/dist/main.js"]
